rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      return signedIn() && profile().role in roles;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow create: if isSelf(userId);
      allow get: if isSelf(userId) || hasRole(['admin']);
      allow read: if isSelf(userId) || hasRole(['admin']);
      allow list: if hasRole(['admin']);
      allow update: if isSelf(userId) || hasRole(['admin']);

      match /profileData/{documentId} {
        allow read, write: if isSelf(userId) || hasRole(['admin']);
      }
    }

    match /orders/{orderId} {
      allow create: if signedIn() && request.resource.data.customerId == request.auth.uid;
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        hasRole(['admin', 'vendor', 'rider'])
      );
      allow update: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        hasRole(['admin', 'vendor', 'rider'])
      );
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow write: if hasRole(['admin', 'vendor']);

      match /menu/{itemId} {
        allow read: if true;
        allow write: if hasRole(['admin', 'vendor']);
      }
    }

    match /supportThreads/{threadId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        hasRole(['admin'])
      );

      match /messages/{messageId} {
        allow create: if signedIn() && (
          get(/databases/$(database)/documents/supportThreads/$(threadId)).data.userId == request.auth.uid ||
          hasRole(['admin'])
        );
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/supportThreads/$(threadId)).data.userId == request.auth.uid ||
          hasRole(['admin'])
        );
      }
    }
  }
}
