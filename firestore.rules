rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(roles) {
      return signedIn() && profile().role in roles;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function ownsRestaurant(restaurantId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/restaurants/$(restaurantId)) &&
        get(/databases/$(database)/documents/restaurants/$(restaurantId)).data.ownerId == request.auth.uid;
    }

    function orderBelongsToOwnedRestaurant() {
      return signedIn() &&
        resource.data.restaurantId is string &&
        ownsRestaurant(resource.data.restaurantId);
    }

    function validCustomerProfileCreate(userId) {
      return isSelf(userId) &&
        request.resource.data.id == request.auth.uid &&
        request.resource.data.role == 'customer' &&
        request.resource.data.status == 'active' &&
        request.resource.data.keys().hasOnly([
          'id',
          'name',
          'email',
          'phone',
          'role',
          'avatar',
          'address',
          'status',
          'createdAt',
          'updatedAt'
        ]);
    }

    function validSelfProfileUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name',
        'phone',
        'avatar',
        'address',
        'isOnline',
        'pushTokens',
        'pushTokenUpdatedAt',
        'notificationsMode',
        'updatedAt'
      ]);
    }

    function validOrderCreate() {
      return signedIn() &&
        request.resource.data.customerId == request.auth.uid &&
        request.resource.data.status == 'pending' &&
        !('riderId' in request.resource.data) &&
        request.resource.data.keys().hasOnly([
          'customerId',
          'customerName',
          'customerPhone',
          'restaurantId',
          'restaurantName',
          'items',
          'subtotal',
          'total',
          'deliveryFee',
          'serviceCharge',
          'discount',
          'promoCode',
          'status',
          'paymentMethod',
          'address',
          'createdAt',
          'createdAtIso',
          'estimatedDelivery',
          'updatedAt'
        ]);
    }

    function validCustomerOrderCancel() {
      return resource.data.customerId == request.auth.uid &&
        request.resource.data.status == 'cancelled' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
          'cancelledAt'
        ]);
    }

    function validVendorOrderUpdate() {
      return hasRole(['vendor']) &&
        orderBelongsToOwnedRestaurant() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
          'acceptedAt',
          'preparingAt',
          'readyAt',
          'cancelledAt'
        ]);
    }

    function validRiderOrderUpdate() {
      return hasRole(['rider']) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status',
          'updatedAt',
          'riderId',
          'riderName',
          'pickedUpAt',
          'deliveredAt'
        ]) &&
        (
          (
            resource.data.status == 'ready' &&
            request.resource.data.riderId == request.auth.uid &&
            request.resource.data.status == 'picked_up'
          ) ||
          (
            resource.data.riderId == request.auth.uid &&
            request.resource.data.status in ['picked_up', 'delivered']
          )
        );
    }

    match /users/{userId} {
      allow create: if validCustomerProfileCreate(userId);
      allow get: if isSelf(userId) || hasRole(['admin']);
      allow read: if isSelf(userId) || hasRole(['admin']);
      allow list: if hasRole(['admin']);
      allow update: if hasRole(['admin']) || (isSelf(userId) && validSelfProfileUpdate());

      match /profileData/{documentId} {
        allow read, write: if isSelf(userId) || hasRole(['admin']);
      }
    }

    match /orders/{orderId} {
      allow create: if validOrderCreate();
      allow read: if signedIn() && (
        resource.data.customerId == request.auth.uid ||
        hasRole(['admin']) ||
        (hasRole(['vendor']) && orderBelongsToOwnedRestaurant()) ||
        (hasRole(['rider']) && (resource.data.status == 'ready' || resource.data.riderId == request.auth.uid))
      );
      allow update: if signedIn() && (
        hasRole(['admin']) ||
        validCustomerOrderCancel() ||
        validVendorOrderUpdate() ||
        validRiderOrderUpdate()
      );
    }

    match /restaurants/{restaurantId} {
      allow read: if true;
      allow create: if hasRole(['admin']) || (
        hasRole(['vendor']) &&
        request.resource.data.ownerId == request.auth.uid
      );
      allow update: if hasRole(['admin']) || (
        hasRole(['vendor']) &&
        resource.data.ownerId == request.auth.uid &&
        request.resource.data.ownerId == resource.data.ownerId
      );
      allow delete: if hasRole(['admin']) || (
        hasRole(['vendor']) &&
        resource.data.ownerId == request.auth.uid
      );

      match /menu/{itemId} {
        allow read: if true;
        allow write: if hasRole(['admin']) || (
          hasRole(['vendor']) &&
          ownsRestaurant(restaurantId)
        );
      }
    }

    match /supportThreads/{threadId} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update: if signedIn() && (
        resource.data.userId == request.auth.uid ||
        hasRole(['admin'])
      );

      match /messages/{messageId} {
        allow create: if signedIn() && (
          get(/databases/$(database)/documents/supportThreads/$(threadId)).data.userId == request.auth.uid ||
          hasRole(['admin'])
        );
        allow read: if signedIn() && (
          get(/databases/$(database)/documents/supportThreads/$(threadId)).data.userId == request.auth.uid ||
          hasRole(['admin'])
        );
      }
    }

    match /riderLocations/{riderId} {
      allow read: if signedIn() && (
        request.auth.uid == riderId ||
        hasRole(['admin']) ||
        hasRole(['vendor']) ||
        hasRole(['customer'])
      );
      allow create, update: if signedIn() &&
        request.auth.uid == riderId &&
        hasRole(['rider']) &&
        request.resource.data.riderId == request.auth.uid &&
        request.resource.data.keys().hasOnly([
          'riderId',
          'latitude',
          'longitude',
          'heading',
          'speed',
          'updatedAt',
          'updatedAtIso',
          'isOnline'
        ]);
    }

    match /systemEvents/{eventId} {
      allow read: if hasRole(['admin']);
      allow create, update, delete: if false;
    }

    match /roleRequests/{requestId} {
      allow read: if hasRole(['admin']) || isSelf(requestId);
      allow create: if isSelf(requestId) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.requestedRole in ['vendor', 'rider'] &&
        request.resource.data.status == 'pending';
      allow update: if hasRole(['admin']) ||
        (
          isSelf(requestId) &&
          resource.data.status == 'pending' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'requestedRole',
            'notes',
            'updatedAt'
          ])
        );
      allow delete: if hasRole(['admin']);
    }
  }
}
