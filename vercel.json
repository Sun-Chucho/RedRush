{
  "framework": null,
  "buildCommand": "pnpm build:web",
  "outputDirectory": "dist",
  "installCommand": "pnpm install --frozen-lockfile",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/_expo/(.*)",
      "dest": "/_expo/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/assets/(.*)",
      "dest": "/assets/$1",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      }
    },
    {
      "src": "/favicon.ico",
      "dest": "/favicon.ico"
    },
    {
      "src": "/restaurant/([^/]+)",
      "dest": "/restaurant/[id].html"
    },
    {
      "src": "/order/([^/]+)",
      "dest": "/order/[id].html"
    },
    {
      "src": "/(admin|auth|auth-callback|forgot-password|reset-password|cart|menu|users|orders|search|support|profile|checkout|privacy-policy|terms-of-service|account-deletion|_sitemap|earnings|analytics|onboarding|deliveries)",
      "dest": "/$1.html"
    },
    {
      "src": "/",
      "dest": "/index.html"
    },
    {
      "src": "/.*",
      "dest": "/index.html"
    }
  ]
}
