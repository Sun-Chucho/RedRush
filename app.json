{
  "expo": {
    "name": "RedRush",
    "slug": "onspace-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./logo.png",
    "scheme": "redrush",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "bundleIdentifier": "com.redrush.app",
      "supportsTablet": true,
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "RedRush uses your location to choose KES or TZS pricing and show nearby delivery tracking.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./logo.png",
        "backgroundColor": "#0A0A0A"
      },
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyBQ0Ra_sfrPq0K3LcvZ-zxGZmCUDzYPdTw"
        }
      },
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION"
      ],
      "edgeToEdgeEnabled": true,
      "package": "com.redrush.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./logo.png",
      "backgroundColor": "#0A0A0A",
      "themeColor": "#CC0000"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./logo.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0A0A0A"
        }
      ],
      "expo-web-browser",
      "expo-font",
      "expo-notifications",
      "expo-localization",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "071337b3-dc14-4e0a-9372-195a52541177"
      }
    }
  }
}
